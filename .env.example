# Lost Paint Studios — Studio Control Center Environment Configuration
# Copy this file to .env and adjust variables as needed.

PORT=5000
NODE_ENV=development
DATABASE_PATH=./data/lost_paint.db
JWT_SECRET=replace-with-a-random-64-char-string-in-production
CLIENT_ORIGIN=http://localhost:5173

# Option 1: Render Persistent Disk (Starter plan + Disk)
# When mounting a Render Disk at /data, it is automatically detected.
# DATABASE_PATH=/data/lost_paint.db

# Option 2: Render Free Tier Zero-Cost Cloud Persistence (Upstash Redis REST)
# Keeps your SQLite database 100% persistent across Render Free tier spin-downs for $0!
# Create a free Redis instance in 30 seconds at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option 3: Remote Sync URL / Webhook (Optional alternative)
DATABASE_SYNC_URL=
DATABASE_SYNC_TOKEN=

# Optional: Notion Integration (Internal Integration Secret)
NOTION_TOKEN=
NOTION_PAGE_ID=3e140812c09680fdbffbf5256cfc82ee
